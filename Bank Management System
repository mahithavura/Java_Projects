import java.io.*;
import java.util.*;

class Account {
    int accNo;
    String name;
    double balance;
    ArrayList<String> history;

    public Account(int accNo, String name, double balance) {
        this.accNo = accNo;
        this.name = name;
        this.balance = balance;
        history = new ArrayList<>();
        history.add("Account created with balance: " + balance);
    }

    public void deposit(double amount) {
        balance += amount;
        history.add("Deposited: " + amount);
    }

    public void withdraw(double amount) throws Exception {
        if (amount > balance) {
            throw new Exception("Insufficient Balance!");
        }
        balance -= amount;
        history.add("Withdrawn: " + amount);
    }

    public void showDetails() {
        System.out.println("\nAccount No: " + accNo);
        System.out.println("Name: " + name);
        System.out.println("Balance: " + balance);
    }

    public void showHistory() {
        System.out.println("\nTransaction History:");
        for (String h : history) {
            System.out.println(h);
        }
    }
}

public class BankManagementSystem {

    static HashMap<Integer, Account> accounts = new HashMap<>();
    static int accCounter = 1001;

    public static void createAccount(Scanner sc) {
        System.out.print("Enter name: ");
        String name = sc.nextLine();

        System.out.print("Enter initial balance: ");
        double balance = sc.nextDouble();

        Account acc = new Account(accCounter++, name, balance);
        accounts.put(acc.accNo, acc);

        System.out.println("Account created! Account No: " + acc.accNo);
    }

    public static void deposit(Scanner sc) {
        System.out.print("Enter Account No: ");
        int accNo = sc.nextInt();

        Account acc = accounts.get(accNo);

        if (acc != null) {
            System.out.print("Enter amount: ");
            double amt = sc.nextDouble();
            acc.deposit(amt);
            System.out.println("Deposit successful!");
        } else {
            System.out.println("Account not found!");
        }
    }

    public static void withdraw(Scanner sc) {
        try {
            System.out.print("Enter Account No: ");
            int accNo = sc.nextInt();

            Account acc = accounts.get(accNo);

            if (acc != null) {
                System.out.print("Enter amount: ");
                double amt = sc.nextDouble();
                acc.withdraw(amt);
                System.out.println("Withdrawal successful!");
            } else {
                System.out.println("Account not found!");
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public static void checkBalance(Scanner sc) {
        System.out.print("Enter Account No: ");
        int accNo = sc.nextInt();

        Account acc = accounts.get(accNo);

        if (acc != null) {
            acc.showDetails();
        } else {
            System.out.println("Account not found!");
        }
    }

    public static void transactionHistory(Scanner sc) {
        System.out.print("Enter Account No: ");
        int accNo = sc.nextInt();

        Account acc = accounts.get(accNo);

        if (acc != null) {
            acc.showHistory();
        } else {
            System.out.println("Account not found!");
        }
    }

    public static void saveToFile() {
        try {
            PrintWriter pw = new PrintWriter("accounts.txt");

            for (Account acc : accounts.values()) {
                pw.println(acc.accNo + "," + acc.name + "," + acc.balance);
            }

            pw.close();
            System.out.println("Data saved to file!");
        } catch (Exception e) {
            System.out.println("Error saving file!");
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        while (true) {
            System.out.println("\n--- Bank Management System ---");
            System.out.println("1. Create Account");
            System.out.println("2. Deposit");
            System.out.println("3. Withdraw");
            System.out.println("4. Check Balance");
            System.out.println("5. Transaction History");
            System.out.println("6. Save & Exit");

            System.out.print("Enter choice: ");
            int ch = sc.nextInt();
            sc.nextLine();

            switch (ch) {
                case 1:
                    createAccount(sc);
                    break;
                case 2:
                    deposit(sc);
                    break;
                case 3:
                    withdraw(sc);
                    break;
                case 4:
                    checkBalance(sc);
                    break;
                case 5:
                    transactionHistory(sc);
                    break;
                case 6:
                    saveToFile();
                    System.out.println("Exiting...");
                    return;
                default:
                    System.out.println("Invalid choice!");
            }
        }
    }
}
