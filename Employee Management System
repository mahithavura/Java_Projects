import java.io.*;
import java.util.*;

class Employee {
    int id;
    String name;
    String department;
    double basicSalary;
    double finalSalary;

    public Employee(int id, String name, String department, double basicSalary) {
        this.id = id;
        this.name = name;
        this.department = department;
        this.basicSalary = basicSalary;
        this.finalSalary = calculateSalary();
    }

    public double calculateSalary() {
        return basicSalary + (basicSalary * 0.20);
    }

    public void display() {
        System.out.println("\nID: " + id);
        System.out.println("Name: " + name);
        System.out.println("Department: " + department);
        System.out.println("Basic Salary: " + basicSalary);
        System.out.println("Final Salary: " + finalSalary);
    }
}

public class EmployeeManagementSystem {

    static HashMap<Integer, Employee> map = new HashMap<>();
    static int idCounter = 1;

    public static void addEmployee(Scanner sc) {
        System.out.print("Enter name: ");
        String name = sc.nextLine();

        System.out.print("Enter department: ");
        String dept = sc.nextLine();

        System.out.print("Enter basic salary: ");
        double salary = sc.nextDouble();

        Employee e = new Employee(idCounter++, name, dept, salary);
        map.put(e.id, e);

        System.out.println("Employee added! ID: " + e.id);
    }

    public static void updateEmployee(Scanner sc) {
        System.out.print("Enter Employee ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        Employee e = map.get(id);

        if (e != null) {
            System.out.print("Enter new name: ");
            e.name = sc.nextLine();

            System.out.print("Enter new department: ");
            e.department = sc.nextLine();

            System.out.print("Enter new basic salary: ");
            e.basicSalary = sc.nextDouble();
            e.finalSalary = e.calculateSalary();

            System.out.println("Employee updated!");
        } else {
            System.out.println("Employee not found!");
        }
    }

    public static void deleteEmployee(Scanner sc) {
        System.out.print("Enter Employee ID: ");
        int id = sc.nextInt();

        if (map.remove(id) != null) {
            System.out.println("Employee deleted!");
        } else {
            System.out.println("Employee not found!");
        }
    }

    public static void searchEmployee(Scanner sc) {
        System.out.print("Enter Employee ID: ");
        int id = sc.nextInt();

        Employee e = map.get(id);

        if (e != null) {
            e.display();
        } else {
            System.out.println("Employee not found!");
        }
    }

    public static void displayAll() {
        if (map.isEmpty()) {
            System.out.println("No employees found!");
            return;
        }

        for (Employee e : map.values()) {
            e.display();
        }
    }

    public static void saveToFile() {
        try {
            PrintWriter pw = new PrintWriter("employees.txt");

            for (Employee e : map.values()) {
                pw.println(e.id + "," + e.name + "," + e.department + "," + e.basicSalary);
            }

            pw.close();
            System.out.println("Data saved!");
        } catch (Exception ex) {
            System.out.println("Error saving file!");
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        while (true) {
            System.out.println("\n--- Employee Management System ---");
            System.out.println("1. Add Employee");
            System.out.println("2. Update Employee");
            System.out.println("3. Delete Employee");
            System.out.println("4. Search Employee");
            System.out.println("5. Display All Employees");
            System.out.println("6. Save & Exit");

            System.out.print("Enter choice: ");
            int ch = sc.nextInt();
            sc.nextLine();

            switch (ch) {
                case 1:
                    addEmployee(sc);
                    break;
                case 2:
                    updateEmployee(sc);
                    break;
                case 3:
                    deleteEmployee(sc);
                    break;
                case 4:
                    searchEmployee(sc);
                    break;
                case 5:
                    displayAll();
                    break;
                case 6:
                    saveToFile();
                    System.out.println("Exiting...");
                    return;
                default:
                    System.out.println("Invalid choice!");
            }
        }
    }
}
