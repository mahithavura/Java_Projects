import java.io.*;
import java.util.*;

class Product {
    String name;
    double price;
    int quantity;

    public Product(String name, double price, int quantity) {
        this.name = name;
        this.price = price;
        this.quantity = quantity;
    }

    public double getTotal() {
        return price * quantity;
    }
}

class Bill {
    ArrayList<Product> items = new ArrayList<>();
    double discount = 0;

    public void addItem(Product p) {
        items.add(p);
    }

    public double calculateTotal() {
        double total = 0;
        for (Product p : items) {
            total += p.getTotal();
        }
        return total;
    }

    public double applyDiscount(double total) {
        return total - (total * discount / 100);
    }

    public void generateBill() {
        System.out.println("\n----- BILL -----");

        for (Product p : items) {
            System.out.println(p.name + " | " + p.price + " x " + p.quantity + " = " + p.getTotal());
        }

        double total = calculateTotal();
        System.out.println("\nTotal: " + total);

        double finalAmount = applyDiscount(total);
        System.out.println("Discount: " + discount + "%");
        System.out.println("Final Amount: " + finalAmount);
    }

    public void saveToFile() {
        try {
            PrintWriter pw = new PrintWriter("invoice.txt");

            for (Product p : items) {
                pw.println(p.name + "," + p.price + "," + p.quantity);
            }

            pw.println("Discount: " + discount + "%");
            pw.println("Final Amount: " + applyDiscount(calculateTotal()));

            pw.close();
            System.out.println("Invoice saved!");
        } catch (Exception e) {
            System.out.println("Error saving file!");
        }
    }
}

public class BillingSystem {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Bill bill = new Bill();

        while (true) {
            System.out.println("\n--- Billing System ---");
            System.out.println("1. Add Item");
            System.out.println("2. Apply Discount");
            System.out.println("3. Generate Bill");
            System.out.println("4. Save & Exit");

            System.out.print("Enter choice: ");
            int ch = sc.nextInt();
            sc.nextLine();

            switch (ch) {
                case 1:
                    System.out.print("Enter product name: ");
                    String name = sc.nextLine();

                    System.out.print("Enter price: ");
                    double price = sc.nextDouble();

                    System.out.print("Enter quantity: ");
                    int qty = sc.nextInt();

                    bill.addItem(new Product(name, price, qty));
                    System.out.println("Item added!");
                    break;

                case 2:
                    System.out.print("Enter discount %: ");
                    bill.discount = sc.nextDouble();
                    System.out.println("Discount applied!");
                    break;

                case 3:
                    bill.generateBill();
                    break;

                case 4:
                    bill.saveToFile();
                    System.out.println("Exiting...");
                    return;

                default:
                    System.out.println("Invalid choice!");
            }
        }
    }
}
